# 必填：只填写目标飞行器 SN，不要填写机场/遥控器 SN。
DRONE_DEVICE_SN=REPLACE_WITH_AIRCRAFT_SN

# 必填：DJI Cloud API 使用的 MQTT Broker。
DRONE_MQTT_HOST=REPLACE_MQTT_HOST
DRONE_MQTT_PORT=1883
DRONE_MQTT_USERNAME=
DRONE_MQTT_PASSWORD=
DRONE_MQTT_CLIENT_ID=video-ar-recorder
DRONE_MQTT_KEEPALIVE=60
DRONE_MQTT_CONNECT_TIMEOUT=8

# 公网或生产环境建议启用 TLS；CA 文件可留空以使用系统证书链。
DRONE_MQTT_TLS=false
DRONE_MQTT_TLS_INSECURE=false
DRONE_MQTT_CA_CERT=

# 必填：后台只拉取已经存在的视频流，不会自动向 DJI 下发开始直播指令。
# {device_sn} 会替换为上面的飞行器 SN。若推流 key 不同，请修改整个模板。
DRONE_RTMP_URL_TEMPLATE=rtmp://REPLACE_STREAM_SERVER/live/{device_sn}-81-0-0

# 默认只允许本机 Cesium 页面连接。局域网访问时才改为 0.0.0.0，并配置防火墙。
DRONE_WS_HOST=127.0.0.1
DRONE_WS_STATUS_PORT=8765
DRONE_WS_VIDEO_PORT=8766
DRONE_WS_MAX_MESSAGE_BYTES=10485760
DRONE_WS_SEND_TIMEOUT=0.5

# 性能安全默认值：采集源可为 30 FPS，但只保存 2 FPS、向页面最多推送 10 FPS。
DRONE_FRAME_WIDTH=1280
DRONE_FRAME_HEIGHT=720
DRONE_SAVE_FPS=2
DRONE_BROADCAST_FPS=10
DRONE_JPEG_QUALITY=80
DRONE_VIDEO_OPEN_TIMEOUT_MS=10000
DRONE_VIDEO_READ_TIMEOUT_MS=5000
DRONE_VIDEO_RETRY_SECONDS=5
# 0 表示持续重试。
DRONE_VIDEO_MAX_RETRIES=0
DRONE_VIDEO_CACHE_MAX_FRAMES=600
# 遥测与最近视频帧允许的最大时间差。
DRONE_FRAME_MATCH_MAX_AGE_MS=1500

# DJI height 常为相对起飞点高度。若 Cesium 使用绝对高程，请填写换算偏移。
DRONE_ALTITUDE_FIELD=height
DRONE_ALTITUDE_OFFSET_M=0
# 可选：绝对地面高程（米）。仅当上面的 altitude 已校正为绝对高程时填写；留空不推断。
DRONE_GROUND_ALTITUDE_M=
# 多负载时填写类似 81-0-0；留空则使用首个含云台姿态的负载。
DRONE_PAYLOAD_INDEX=

# 所有运行数据均与 Cesium src/public/dist 隔离。
DRONE_DATA_DIR=./data
DRONE_CHECKPOINT_SECONDS=30
# true 会在航次结束时额外生成 ZIP，占用额外磁盘空间。
DRONE_AUTO_ZIP=false
DRONE_LOG_LEVEL=INFO
DRONE_LOG_MAX_BYTES=5242880
DRONE_LOG_BACKUPS=3
