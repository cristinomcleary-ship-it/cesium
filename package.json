{
  "name": "cesium-cad-photogrammetry-viewer",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "overrides": {
    "@cesium/engine": "26.2.0",
    "@cesium/widgets": "16.1.1"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node tools/run-temporary-works-regression.mjs all",
    "test:cpu": "node tests/model-placement-regression.mjs && node tests/video-overlay-cache-boundaries.mjs && node tests/video-overlay-access-regression.mjs",
    "test:tools": "node --test tools/inspect-video-ar-recovery.test.cjs tools/validate-platform-ar-checkpoints.test.mjs tools/designed-surfaces-preview/preview.test.mjs tools/temporary-works-assets/geometry-signs.test.mjs",
    "test:python": "node tools/run-python-tests.mjs"
  },
  "dependencies": {
    "@cesium/engine": "26.2.0",
    "@mlightcad/libredwg-web": "^0.7.9",
    "cesium": "1.144.0",
    "clipper-lib": "6.4.2",
    "echarts": "6.1.0",
    "geotiff": "^3.0.5",
    "koffi": "3.3.2",
    "mediabunny": "1.61.6",
    "polygon-clipping": "0.15.7",
    "proj4": "^2.19.10",
    "sql.js": "^1.14.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/three": "0.180.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-static-copy": "^3.1.2"
  }
}
